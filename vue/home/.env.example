# Environment Variables Example
# Copy this file to .env.local and customize the values

# App Configuration
VITE_APP_TITLE=Vue 3 App
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# API Configuration
VITE_API_BASE_URL=http://8.220.222.43:8666
VITE_API_TIMEOUT=10000

# Development Server (only used in development)
VITE_PORT=3000
VITE_HOST=localhost

# Feature Flags
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_DEBUG=true
VITE_SHOW_PERFORMANCE_MONITOR=false

# Logging
VITE_LOG_LEVEL=info
VITE_ENABLE_AXIOS_LOGGING=true

# Cache Configuration
VITE_CACHE_TTL=300000

# Analytics and Monitoring (production only)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false

# Performance
VITE_ENABLE_LAZY_LOADING=false